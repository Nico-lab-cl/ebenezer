---
/* Fuentes servidas desde el propio sitio (no desde Google): así ningún tercero
   recibe la IP del visitante sin su consentimiento (Ley 21.719). */
import '@fontsource/saira/600.css';
import '@fontsource/saira/700.css';
import '@fontsource/saira/800.css';
import '@fontsource/saira/900.css';
import '@fontsource/saira/700-italic.css';
import '@fontsource/saira/800-italic.css';
import '@fontsource/saira/900-italic.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFab from '@/components/WhatsAppFab.astro';
import CookieAviso from '@/components/CookieAviso.astro';
import Analytics from '@/components/Analytics.astro';
import ajustes from '@/content/ajustes.json';
import { automotora, sitioWeb } from '@/lib/schema';
import type { Contexto, AutoWa } from '@/lib/whatsapp';

interface Props {
  title: string;
  description: string;
  /** Imagen para redes (URL absoluta o ruta). Por defecto, /og/ebenezer.jpg (1200×630). */
  image?: string;
  /** Texto alternativo de la imagen para redes */
  imageAlt?: string;
  /** JSON-LD extra de la página */
  schema?: object[];
  fab?: { context?: Contexto; auto?: AutoWa } | false;
  noindex?: boolean;
  /** Página de anuncios: header sin menú y pie corto */
  minimal?: boolean;
}
const { title, description, image, imageAlt, schema = [], fab = {}, noindex = false, minimal = false } = Astro.props;
const site = Astro.site ?? new URL(ajustes.dominio);
const canonica = new URL(Astro.url.pathname, site).href;
/* Imagen para compartir: 1200×630 (proporción 1,91:1 que piden Facebook,
   WhatsApp, LinkedIn y X). Las fichas de autos pasan la foto del auto. */
const ogPorDefecto = !image;
const ogAbs = new URL(image ?? '/og/ebenezer.jpg', site).href;
const ogAlt = imageAlt ?? 'EBENEZER Automotora, compra y venta de autos en la Región de Valparaíso';
const titulo = title.includes('EBENEZER') ? title : `${title} · EBENEZER Automotora`;
const datos = [automotora(site), sitioWeb(site), ...schema];
---
<!doctype html>
<html lang="es-CL" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    {/* max-image-preview:large permite miniaturas grandes en Google (Discover, imágenes). */}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#14171B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={ajustes.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:image:alt" content={ogAlt} />
    {ogPorDefecto && <meta property="og:image:width" content="1200" />}
    {ogPorDefecto && <meta property="og:image:height" content="630" />}
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <meta name="twitter:image:alt" content={ogAlt} />


    {datos.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header minimal={minimal} />
    <main id="contenido">
      <slot />
    </main>
    {minimal ? (
      <footer class="ebz-footer"><div class="ebz-container ebz-footer__bottom"><span>EBENEZER Automotora · Región de Valparaíso</span><a href="/">Ver el sitio completo</a><nav class="pie-legal" aria-label="Legal"><a href="/politica-de-privacidad/">Política de privacidad</a><a href="/politica-de-cookies/">Cookies</a><a href="/terminos/">Términos de uso</a><button type="button" data-ck-config>Configurar cookies</button></nav></div></footer>
    ) : (
      <Footer />
    )}
    {fab !== false && <WhatsAppFab {...fab} />}
    <CookieAviso />
    <script>
      // Celular: los bloques [data-plegable] largos parten plegados con "Leer más".
      if (matchMedia("(max-width: 767px)").matches) {
        for (const el of document.querySelectorAll<HTMLElement>("[data-plegable]")) {
          if (el.scrollHeight < 220) continue;
          el.classList.add("plegable--listo");
          const b = document.createElement("button");
          b.type = "button";
          b.className = "plegable__btn";
          b.textContent = "Leer más";
          b.setAttribute("aria-expanded", "false");
          b.addEventListener("click", () => {
            el.classList.add("plegable--abierto");
            b.setAttribute("aria-expanded", "true");
            b.hidden = true;
          });
          el.after(b);
        }
      }
    </script>
  </body>
</html>

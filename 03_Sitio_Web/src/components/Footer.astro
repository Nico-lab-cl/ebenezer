---
import Icon from './Icon.astro';
import Checkered from './Checkered.astro';
import ajustes from '@/content/ajustes.json';
import { real } from '@/lib/datos';
import { numeroWhatsapp } from '@/lib/whatsapp';

// Zonas de la región que atiende la automotora (base en El Tabo).
const ZONAS = ['Litoral central', 'Gran Valparaíso', 'Marga Marga', 'Quillota', 'Aconcagua'];
const anio = new Date().getFullYear();
---
<footer class="ebz-footer">
  <div class="ebz-container">
    <div class="ebz-footer__grid">
      <div style="display:flex;flex-direction:column;gap:20px">
        <img src="/assets/logo/ebenezer-logo-blanco.svg" alt="EBENEZER Automotora, compra y venta de autos" style="height:52px;width:auto" loading="lazy" />
        <p style="max-width:320px;line-height:1.6">Autos usados y seminuevos revisados, con precio claro y transferencia digital. Automotora del litoral central para toda la Quinta Región.</p>
        <Checkered />
      </div>
      <div>
        <h4>Vender</h4>
        <ul>
          <li><a href="/vender-mi-auto/">Consignación</a></li>
          <li><a href="/vender-mi-auto/#tasar">Tasar mi auto</a></li>
          <li><a href="/vender-mi-auto/#preguntas">Preguntas de dueños</a></li>
        </ul>
      </div>
      <div>
        <h4>Comprar</h4>
        <ul>
          <li><a href="/autos-usados/">Autos usados</a></li>
          <li><a href="/financiamiento/">Crédito directo</a></li>
        </ul>
      </div>
      <div>
        <h4>EBENEZER</h4>
        <ul>
          <li><a href="/nosotros/">Nosotros</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h4>Contacto</h4>
        <ul>
          {real(ajustes.direccion) && <li style="display:flex;gap:8px"><Icon name="map-pin" size={16} style="margin-top:2px" />{ajustes.direccion}, {ajustes.comuna}</li>}
          {real(ajustes.telefono) && <li><a style="display:flex;gap:8px" href={`https://wa.me/${numeroWhatsapp()}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} style="margin-top:2px" />{ajustes.telefono}</a></li>}
          {real(ajustes.email) && <li><a style="display:flex;gap:8px" href={`mailto:${ajustes.email}`}><Icon name="mail" size={16} style="margin-top:2px" />{ajustes.email}</a></li>}
          {real(ajustes.horario) && <li style="display:flex;gap:8px"><Icon name="clock" size={16} style="margin-top:2px" />{ajustes.horario}</li>}
          {(ajustes.instagram || ajustes.facebook) && (
            <li style="display:flex;gap:14px;margin-top:6px">
              {ajustes.instagram && <a href={ajustes.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={20} /></a>}
              {ajustes.facebook && <a href={ajustes.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={20} /></a>}
            </li>
          )}
        </ul>
      </div>
    </div>
    <div class="ebz-footer__bottom">
      <span>Atendemos toda la Región de Valparaíso · {ZONAS.join(' · ')}</span>
      <span>© {anio} {ajustes.nombre} · Precios en CLP con IVA incluido</span>
    </div>
  </div>
</footer>

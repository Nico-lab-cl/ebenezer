---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';
import Checkered from './Checkered.astro';
import carretera from '@/assets/marca/carretera-bn.png';
// Recorte sin los márgenes transparentes del original (883×669): así la
// imagen ocupa sólo el auto y escala sin deformarse.
import recorte from '@/assets/marca/audi-tt-2011-hero.png';

/* Hero de la vitrina (/comprar): fondo de carretera, panel de estudio y el
   auto destacado en estudio. Arriba del catálogo, para que el auto se vea
   como parte del stock y no como lo único que vende la automotora.
   Si cambia el auto destacado, hay que cambiar también el recorte. */
interface Props {
  /** Ficha del auto que aparece en la foto */
  ficha?: string;
  /** Ancla del catálogo en la misma página */
  catalogo?: string;
}
const { ficha, catalogo = '#catalogo' } = Astro.props;
const fondo = await getImage({ src: carretera, width: 1600, format: 'webp', quality: 60 });
const PUNTOS = ['Revisados antes de publicarse', 'Precio final a la vista', 'Financiamiento directo con la automotora'];
---
<section class="ebz-hero" data-theme="dark" style={`--hero-bg:url("${fondo.src}")`}>
  <div class="ebz-hero__bg"></div>
  <div class="ebz-hero__panel"></div>
  <div class="ebz-container">
    <div class="ebz-hero__in ebz-hero__in--solo">
      <div style="display:flex;flex-direction:column;gap:24px">
        <span class="ebz-overline ebz-overline-rule" style="color:var(--grafito-300)">Autos disponibles · Región de Valparaíso</span>
        <h1 class="ebz-display">Tu próximo auto, revisado</h1>
        <p class="ebz-body-lg" style="color:var(--grafito-300);max-width:500px">Autos usados y seminuevos que revisamos antes de publicar, con precio final a la vista y financiamiento directo con nosotros.</p>
        <ul class="hero-puntos">
          {PUNTOS.map((p) => <li><Icon name="check" size={18} />{p}</li>)}
        </ul>
        <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:4px">
          <Button size="lg" iconRight="arrow-right" href={catalogo}>Ver catálogo</Button>
          <Button size="lg" variant="secondary" href="/financiamiento/#simulador">Simular crédito</Button>
        </div>
      </div>
      <a class="ebz-hero__car" href={ficha ?? catalogo} aria-label="Ver la ficha del auto disponible">
        <div class="hero-car-label"><Badge tone="seminuevo" /><span>Disponible ahora</span></div>
        <Image src={recorte} alt="Audi TT 2011 fotografiado en estudio por EBENEZER" widths={[360, 560, 720, 883]} sizes="(max-width: 599px) 92vw, (max-width: 1023px) 520px, (max-width: 1279px) 560px, 680px" loading="eager" fetchpriority="high" format="webp" />
        <Checkered width={110} size={9} class="hero-checkered" />
      </a>
    </div>
  </div>
</section>

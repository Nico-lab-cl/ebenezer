---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';
import Checkered from './Checkered.astro';
import LeadVenta from './LeadVenta.astro';
import carretera from '@/assets/marca/carretera-bn.png';
// Recorte sin los márgenes transparentes del original (883×669): así la
// imagen ocupa sólo el auto y escala sin deformarse.
import recorte from '@/assets/marca/audi-tt-2011-hero.png';

/* Hero de consignación. La vía principal es "vende tu auto con nosotros";
   la segunda, "ver autos disponibles", baja a la sección #autos. */
interface Props {
  /** Ancla o URL de la sección de autos disponibles */
  autos?: string;
}
const { autos = '#autos' } = Astro.props;
const fondo = await getImage({ src: carretera, width: 1600, format: 'webp', quality: 60 });
const PUNTOS = ['Fotos de estudio y anuncios pagados', 'Nosotros atendemos a los compradores', 'Sin costo hasta que se vende'];
---
<section class="ebz-hero" data-theme="dark" style={`--hero-bg:url("${fondo.src}")`}>
  <div class="ebz-hero__bg"></div>
  <div class="ebz-hero__panel"></div>
  <div class="ebz-container">
    <div class="ebz-hero__in">
      <div style="display:flex;flex-direction:column;gap:24px">
        <span class="ebz-overline ebz-overline-rule" style="color:var(--grafito-300)">Consignación de autos · Región de Valparaíso</span>
        <h1 class="ebz-display">Vendemos tu auto por ti.</h1>
        <p class="ebz-body-lg" style="color:var(--grafito-300);max-width:500px">Lo recibimos en consignación, lo fotografiamos en estudio y lo promocionamos con publicidad pagada. Tú no atiendes llamadas ni visitas: sólo firmas cuando se vende.</p>
        <ul class="hero-puntos">
          {PUNTOS.map((p) => <li><Icon name="check" size={18} />{p}</li>)}
        </ul>
        <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:4px">
          <Button size="lg" iconRight="arrow-right" href="#tasar">Tasar mi auto</Button>
          <Button size="lg" variant="secondary" href={autos}>Ver autos disponibles</Button>
        </div>
      </div>
      <div class="ebz-hero__car">
        <div class="hero-car-label"><Badge tone="seminuevo" /><span>Así publicamos tu auto</span></div>
        <Image src={recorte} alt="Audi TT 2011 fotografiado en estudio por EBENEZER" widths={[360, 560, 720, 883]} sizes="(max-width: 599px) 92vw, (max-width: 1023px) 520px, (max-width: 1279px) 560px, 680px" loading="eager" fetchpriority="high" format="webp" />
        <Checkered width={110} size={9} class="hero-checkered" />
      </div>
    </div>
  </div>
  <div class="ebz-container" style="padding-bottom:56px" id="tasar">
    <div class="ebz-hero__search"><LeadVenta id="lead-hero" variante="barra" titulo="Tasa tu auto sin costo" /></div>
  </div>
</section>

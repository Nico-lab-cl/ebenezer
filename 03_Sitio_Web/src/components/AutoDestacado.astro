---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { clp, km } from '@/lib/formato';
import { type Vehiculo, nombre, url, cuotaDesde, autoWa } from '@/lib/vehiculos';

/* Un auto en grande. Con poco inventario, cada auto merece vitrina propia
   en vez de una grilla con huecos. */
interface Props {
  v: Vehiculo;
}
const { v } = Astro.props;
const d = v.data;
const foto = d.fotos[0];
const vendido = d.etiqueta === 'vendido';
---
<article class="destacado">
  <a class="destacado__media studio" href={url(v)} aria-label={nombre(v)}>
    {foto ? (
      <Image src={foto.imagen} alt={`${nombre(v)} en estudio`} widths={[480, 720, 960]} sizes="(max-width: 1023px) 100vw, 640px" format="webp" />
    ) : (
      <span class="ebz-photo-ph"><Icon name="car" size={48} />Foto en estudio</span>
    )}
    <Badge tone={d.etiqueta} size="lg" class="destacado__badge" />
  </a>
  <div class="destacado__body">
    <div>
      <div class="ebz-vcard__brand">{d.marca}</div>
      <h3 class="ebz-h2" style="margin-top:4px"><a href={url(v)} style="color:inherit;text-decoration:none">{d.modelo} <span class="ebz-num" style="color:var(--text-accent)">{d.anio}</span></a></h3>
      {d.version && <p class="ebz-body muted" style="margin-top:6px">{d.version}</p>}
    </div>
    <ul class="destacado__specs">
      <li><Icon name="gauge" size={18} /><span class="ebz-num">{km(d.km)}</span></li>
      <li><Icon name="cog" size={18} />{d.transmision}</li>
      <li><Icon name="fuel" size={18} />{d.combustible}</li>
    </ul>
    <div style="padding-top:18px;border-top:1px solid var(--border-subtle)">
      {d.precioAnterior && <div class="ebz-vcard__was ebz-num">{clp(d.precioAnterior)}</div>}
      <div class="ebz-price ebz-price-lg">{vendido ? 'Vendido' : clp(d.precio)}</div>
      {!vendido && <div class="ebz-caption" style="margin-top:6px">IVA incluido · Cuota ref. desde <b class="ebz-num" style="color:var(--text-primary)">{clp(cuotaDesde(v))}</b>/mes</div>}
    </div>
    <div class="row">
      <Button href={url(v)} size="lg" iconRight="arrow-right">Ver ficha</Button>
      {!vendido && <WhatsAppButton auto={autoWa(v)} variant="secondary" size="lg">Consultar</WhatsAppButton>}
    </div>
  </div>
</article>

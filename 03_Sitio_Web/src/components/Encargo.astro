---
import Icon from './Icon.astro';
import Button from './Button.astro';
import ajustes from '@/content/ajustes.json';
import { numeroWhatsapp } from '@/lib/whatsapp';

/* "¿Buscas otro auto? Te lo conseguimos": con poco stock, el comprador que
   no encuentra lo suyo deja su pedido. Además le dice al equipo qué autos
   salir a buscar para consignar. */
interface Props {
  id: string;
}
const { id } = Astro.props;
const PRESUPUESTOS = ['Hasta $8 millones', '$8 a $12 millones', '$12 a $18 millones', 'Más de $18 millones'];
const f = (n: string) => `${id}-${n}`;
---
<form class="encargo" data-lead="compra" data-wa={numeroWhatsapp()} data-sheets={ajustes.sheetsUrl} id={id}>
  <div class="stack" style="gap:10px">
    <span class="ebz-overline" style="color:var(--text-accent)">Encargo</span>
    <h3 class="ebz-h3">¿Buscas otro auto? Te lo conseguimos</h3>
    <p class="ebz-body-sm muted">Cuéntanos qué buscas y te avisamos apenas entre uno a consignación.</p>
  </div>
  <div class="encargo__campos" data-campos>
    <div class="ebz-field encargo__ancho"><label class="ebz-label" for={f('busca')}>Qué auto buscas</label><div class="ebz-control"><Icon name="search" size={18} /><input id={f('busca')} name="busca" class="ebz-input ebz-input--icon" placeholder="Ej. SUV automático 2018 o más nuevo" required /></div></div>
    <div class="ebz-field encargo__ancho"><label class="ebz-label" for={f('presupuesto')}>Presupuesto</label><div class="ebz-control"><select id={f('presupuesto')} name="presupuesto" class="ebz-select"><option value="">Selecciona</option>{PRESUPUESTOS.map((p) => <option>{p}</option>)}</select><Icon name="chevron-down" size={18} class="ebz-select__chev" /></div></div>
    <div class="ebz-field"><label class="ebz-label" for={f('nombre')}>Nombre</label><div class="ebz-control"><input id={f('nombre')} name="nombre" class="ebz-input" autocomplete="name" required /></div></div>
    <div class="ebz-field"><label class="ebz-label" for={f('tel')}>WhatsApp</label><div class="ebz-control"><input id={f('tel')} name="telefono" type="tel" class="ebz-input" placeholder="+56 9…" autocomplete="tel" required pattern="[0-9+ ]{8,16}" /></div></div>
    <div class="lead__oculto" aria-hidden="true"><label>No llenar<input name="sitio_web" tabindex="-1" autocomplete="off" /></label></div>
    <div class="encargo__ancho"><Button type="submit" variant="dark" block iconRight="arrow-right">Avísame cuando llegue</Button></div>
  </div>
  <div class="lead__gracias" data-gracias hidden>
    <p class="ebz-h4" tabindex="-1">Te avisamos apenas llegue uno</p>
    <p class="ebz-body-sm muted">Si quieres, deja tu pedido también en WhatsApp, así te llega directo cuando tengamos uno.</p>
    <Button href="#" target="_blank" icon="whatsapp" variant="secondary" data-gracias-wa>Dejar pedido en WhatsApp</Button>
  </div>
</form>

<script>
  import '@/scripts/leads';
</script>

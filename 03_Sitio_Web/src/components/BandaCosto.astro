---
import Button from './Button.astro';
import Checkered from './Checkered.astro';
import ajustes from '@/content/ajustes.json';
---
<section class="banda sec--lg">
  <div class="banda__diag"></div>
  <div class="ebz-container banda__in">
    <div class="stack" style="flex:6 1 420px">
      <Checkered />
      <h2 class="ebz-h1">Nosotros invertimos en la publicidad de tu auto.</h2>
      <p class="ebz-body-lg" style="color:var(--grafito-300);max-width:540px">Fotos, anuncios y atención de compradores corren por nuestra cuenta. Cobramos {ajustes.comision} sólo cuando el auto se vende.</p>
      <div class="row"><Button size="lg" iconRight="arrow-right" href="#tasar">Tasar mi auto</Button></div>
    </div>
    <div class="banda__big" style="flex:4 1 260px">
      <span class="ebz-display">$0</span>
      <span class="ebz-overline" style="font-weight:700">Hasta que se vende</span>
    </div>
  </div>
</section>

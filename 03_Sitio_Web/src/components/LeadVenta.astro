---
import Icon from './Icon.astro';
import Button from './Button.astro';
import ajustes from '@/content/ajustes.json';
import { numeroWhatsapp } from '@/lib/whatsapp';
import { REGIONES, REGION_POR_DEFECTO, comunasDe } from '@/lib/comunas';

/* Formulario "Vende tu auto": el corazón del sitio en esta etapa.
   Tres pasos (tu auto → cómo quieres venderlo → tus datos) para no mostrar
   todos los campos de golpe. Sin JS se ven los tres pasos juntos y el envío
   funciona igual. Variantes: "barra" (bajo el hero, 4 columnas) y "panel"
   (columna, en /tasacion y /vender-mi-auto).
   No hay filtro de año ni kilometraje: entra todo y lo revisa el equipo. */
interface Props {
  id: string;
  variante?: 'barra' | 'panel';
  titulo?: string;
}
const { id, variante = 'panel', titulo = 'Tasa tu auto gratis' } = Astro.props;
const anios = Array.from({ length: 41 }, (_, i) => String(new Date().getFullYear() + 1 - i));
// Marcas más comunes en el mercado de usados en Chile; el resto va en "Otra marca".
const MARCAS = ['Audi', 'BMW', 'BYD', 'Changan', 'Chery', 'Chevrolet', 'Citroën', 'Dodge', 'DFSK', 'Fiat', 'Ford', 'Geely', 'Great Wall', 'Haval', 'Honda', 'Hyundai', 'JAC', 'Jeep', 'Kia', 'Land Rover', 'Mahindra', 'Maxus', 'Mazda', 'Mercedes-Benz', 'MG', 'Mini', 'Mitsubishi', 'Nissan', 'Opel', 'Peugeot', 'Porsche', 'Ram', 'Renault', 'Seat', 'Skoda', 'SsangYong', 'Subaru', 'Suzuki', 'Toyota', 'Volkswagen', 'Volvo'];
const URGENCIAS = ['Lo antes posible', 'Este mes', 'En 1 a 3 meses', 'Sólo quiero saber cuánto vale'];
const f = (n: string) => `${id}-${n}`;
---
<form class={`lead lead--${variante}`} data-theme="dark" data-lead="venta" data-wa={numeroWhatsapp()} data-sheets={ajustes.sheetsUrl} id={id}>
  <div class="lead__head">
    <h2 class="ebz-h4" style="font-style:italic;font-weight:800">{titulo}</h2>
    <p class="ebz-caption" data-paso-txt>Te respondemos por WhatsApp en menos de 24 horas hábiles.</p>
  </div>
  <div class="lead__progreso" aria-hidden="true"><span data-progreso></span></div>

  <div class="lead__campos" data-campos>
    <fieldset class="lead__paso" data-paso="1">
      <legend class="lead__legend">Tu auto</legend>
      <div class="ebz-field">
        <label class="ebz-label" for={f('patente')}>Patente</label>
        <div class="ebz-control"><Icon name="scan-line" size={18} /><input id={f('patente')} name="patente" class="ebz-input ebz-input--icon" placeholder="Ej. DGLR28" required minlength="6" maxlength="9" autocomplete="off" autocapitalize="characters" spellcheck="false" style="text-transform:uppercase" data-patente /></div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('marca')}>Marca</label>
        <div class="ebz-control">
          <select id={f('marca')} name="marca" class="ebz-select" required data-marca><option value="">Selecciona</option>{MARCAS.map((m) => <option>{m}</option>)}<option value="Otra">Otra marca</option></select>
          <Icon name="chevron-down" size={18} class="ebz-select__chev" />
        </div>
      </div>
      <div class="ebz-field lead__ancho" data-marca-otra hidden>
        <label class="ebz-label" for={f('marca-otra')}>¿Cuál marca?</label>
        <div class="ebz-control"><input id={f('marca-otra')} name="marca_otra" class="ebz-input" placeholder="Escribe la marca" autocomplete="off" disabled /></div>
      </div>
      <div class="ebz-field lead__ancho">
        <label class="ebz-label" for={f('modelo')}>Modelo y versión</label>
        <div class="ebz-control"><input id={f('modelo')} name="modelo" class="ebz-input" placeholder="Ej. Yaris 1.5 GLI" required /></div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('anio')}>Año</label>
        <div class="ebz-control">
          <select id={f('anio')} name="anio" class="ebz-select" required><option value="">Año</option>{anios.map((a) => <option>{a}</option>)}</select>
          <Icon name="chevron-down" size={18} class="ebz-select__chev" />
        </div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('km')}>Kilometraje</label>
        <div class="ebz-control"><input id={f('km')} name="km" class="ebz-input" placeholder="Ej. 98.000" inputmode="numeric" pattern="[0-9.]{1,9}" required data-miles /><span class="ebz-input__suffix">km</span></div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('transmision')}>Transmisión <span class="lead__opc">opcional</span></label>
        <div class="ebz-control">
          <select id={f('transmision')} name="transmision" class="ebz-select"><option value="">Selecciona</option><option>Manual</option><option>Automática</option></select>
          <Icon name="chevron-down" size={18} class="ebz-select__chev" />
        </div>
      </div>
      <div class="lead__nav" data-nav hidden><Button type="button" size="lg" block iconRight="arrow-right" data-siguiente>Continuar</Button></div>
    </fieldset>

    <fieldset class="lead__paso" data-paso="2">
      <legend class="lead__legend">Cómo quieres venderlo</legend>
      <div class="ebz-field lead__ancho">
        <label class="ebz-label" for={f('intencion')}>Modalidad</label>
        <div class="ebz-control">
          <select id={f('intencion')} name="intencion" class="ebz-select" required><option value="">Selecciona</option><option>Consignación</option><option>Venta directa</option></select>
          <Icon name="chevron-down" size={18} class="ebz-select__chev" />
        </div>
        <p class="lead__ayuda" data-ayuda-intencion></p>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('precio')}>¿Cuánto esperas recibir? <span class="lead__opc">opcional</span></label>
        <div class="ebz-control"><span class="lead__prefijo">$</span><input id={f('precio')} name="precio_esperado" class="ebz-input lead__con-prefijo" placeholder="Ej. 8.500.000" inputmode="numeric" pattern="[0-9.]{1,12}" data-miles /></div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('urgencia')}>¿Cuándo quieres venderlo?</label>
        <div class="ebz-control">
          <select id={f('urgencia')} name="urgencia" class="ebz-select" required><option value="">Selecciona</option>{URGENCIAS.map((u) => <option>{u}</option>)}</select>
          <Icon name="chevron-down" size={18} class="ebz-select__chev" />
        </div>
      </div>
      <div class="lead__nav" data-nav hidden>
        <Button type="button" variant="ghost" icon="arrow-left" data-atras>Volver</Button>
        <Button type="button" size="lg" iconRight="arrow-right" data-siguiente>Continuar</Button>
      </div>
    </fieldset>

    <fieldset class="lead__paso" data-paso="3">
      <legend class="lead__legend">Tus datos</legend>
      <div class="ebz-field lead__ancho">
        <label class="ebz-label" for={f('nombre')}>Tu nombre</label>
        <div class="ebz-control"><input id={f('nombre')} name="nombre" class="ebz-input" placeholder="Nombre y apellido" autocomplete="name" required /></div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('tel')}>WhatsApp</label>
        <div class="ebz-control"><Icon name="phone" size={18} /><input id={f('tel')} name="telefono" type="tel" class="ebz-input ebz-input--icon" placeholder="+56 9 1234 5678" autocomplete="tel" required pattern="[0-9+ ]{8,16}" /></div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('email')}>Email <span class="lead__opc">opcional</span></label>
        <div class="ebz-control"><input id={f('email')} name="email" type="email" class="ebz-input" placeholder="tu@email.cl" autocomplete="email" /></div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('region')}>Región</label>
        <div class="ebz-control">
          <select id={f('region')} name="region" class="ebz-select" required data-region>{REGIONES.map((r) => <option selected={r.nombre === REGION_POR_DEFECTO}>{r.nombre}</option>)}</select>
          <Icon name="chevron-down" size={18} class="ebz-select__chev" />
        </div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('comuna')}>Comuna</label>
        <div class="ebz-control">
          <select id={f('comuna')} name="comuna" class="ebz-select" required data-comuna><option value="">Comuna</option>{comunasDe(REGION_POR_DEFECTO).map((c) => <option>{c}</option>)}</select>
          <Icon name="chevron-down" size={18} class="ebz-select__chev" />
        </div>
      </div>
      <label class="lead__check lead__ancho"><input type="checkbox" name="consentimiento" value="Política de privacidad 2026-10-08" required /> <span>Acepto que EBENEZER use estos datos para tasar mi auto y contactarme por WhatsApp, según la <a href="/politica-de-privacidad/" target="_blank">Política de privacidad</a>.</span></label>
      <div class="lead__oculto" aria-hidden="true"><label>No llenar<input name="sitio_web" tabindex="-1" autocomplete="off" /></label></div>
      <div class="lead__nav lead__nav--final">
        <Button type="button" variant="ghost" icon="arrow-left" data-atras data-nav hidden>Volver</Button>
        <Button type="submit" size="lg" iconRight="arrow-right">Quiero vender mi auto</Button>
      </div>
    </fieldset>
  </div>

  <div class="lead__gracias" data-gracias hidden>
    <span class="lead__ok"><Icon name="check" size={28} /></span>
    <p class="ebz-h3" tabindex="-1">Recibimos tu auto</p>
    <p class="ebz-body muted">Te escribimos por WhatsApp en menos de 24 horas hábiles con la tasación. Si quieres adelantar, mándanos fotos ahora. El mensaje ya va con tus datos y nosotros nos encargamos de que se vean bien.</p>
    <Button href="#" target="_blank" icon="whatsapp" data-gracias-wa>Enviar fotos por WhatsApp</Button>
  </div>
</form>

<script>
  import '@/scripts/leads';
</script>

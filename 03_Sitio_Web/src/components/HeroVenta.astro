---
import Icon from './Icon.astro';
import Checkered from './Checkered.astro';
import LeadVenta from './LeadVenta.astro';

/* Hero de las páginas de venta (/vender-mi-auto y /tasacion): el formulario
   queda arriba, visible sin hacer scroll, que es lo que pide un anuncio. */
const PUNTOS = [
  ['camera', 'Fotos de estudio como las de una marca'],
  ['zap', 'Anuncios pagados en Facebook e Instagram'],
  ['message-circle', 'Atendemos a los compradores por ti'],
  ['banknote', 'Consignación o venta directa, tú eliges'],
];
---
<section style="position:relative;overflow:hidden" id="tasar">
  <div class="studio" style="position:absolute;top:0;right:0;width:42%;height:100%;clip-path:polygon(30% 0,100% 0,100% 100%,0 100%);opacity:.08"></div>
  <div class="ebz-container split split--top" style="position:relative;gap:56px;padding-top:64px;padding-bottom:80px">
    <div class="stack" style="gap:22px;flex:5 1 360px">
      <span class="ebz-overline ebz-overline-rule" style="color:var(--grafito-300)">Consignación o venta directa</span>
      <h1 class="ebz-h1">Vende tu auto con nosotros y tú eliges cómo</h1>
      <p class="ebz-body-lg muted">Déjalo en consignación y sigue usándolo hasta que haya un comprador, o te hacemos una oferta y te lo compramos. Completa el formulario y te enviamos la tasación por WhatsApp.</p>
      <ul class="lista-check" style="gap:14px;margin-top:6px">
        {PUNTOS.map(([ic, t]) => <li><Icon name={ic!} size={20} /><span class="ebz-body" style="font-weight:600">{t}</span></li>)}
      </ul>
      <Checkered />
    </div>
    <div style="flex:5 1 400px">
      <LeadVenta id="lead-venta" variante="panel" />
    </div>
  </div>
</section>

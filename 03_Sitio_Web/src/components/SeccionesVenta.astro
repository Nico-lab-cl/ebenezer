---
import ConsignaPasos from './ConsignaPasos.astro';
import Comparativa from './Comparativa.astro';
import BandaCosto from './BandaCosto.astro';
import FaqVendedor from './FaqVendedor.astro';
import Button from './Button.astro';

/* El argumento de venta para el dueño del auto, en el orden en que se
   resuelven sus dudas: cómo funciona → por qué con nosotros → cuánto cuesta
   → preguntas. Se usa en la portada, /vender-mi-auto y /tasacion. */
interface Props {
  /** La portada intercala la sección de autos entre la banda y las preguntas */
  sinFaq?: boolean;
}
const { sinFaq = false } = Astro.props;
---
<section class="ebz-container sec--lg" id="como-funciona">
  <div class="sec-head"><div class="sec-head__t">
    <span class="ebz-overline ebz-overline-rule" style="color:var(--grafito-300)">Cómo funciona</span>
    <h2 class="ebz-h2">Consignación en 4 pasos.</h2>
  </div></div>
  <ConsignaPasos />
</section>

<section data-theme="light" class="sec sec--light">
  <div class="ebz-container split split--top" style="gap:56px">
    <div class="stack" style="flex:4 1 320px">
      <span class="ebz-overline" style="color:var(--text-accent)">Por qué con nosotros</span>
      <h2 class="ebz-h2">Véndelo tú o deja que lo vendamos.</h2>
      <p class="ebz-body-lg muted">Vender un auto usado por tu cuenta toma semanas de llamadas, visitas y regateo. Nosotros nos encargamos de eso.</p>
      <div class="row"><Button href="#tasar" iconRight="arrow-right">Tasar mi auto</Button></div>
    </div>
    <div style="flex:7 1 520px;min-width:0"><Comparativa /></div>
  </div>
</section>

<BandaCosto />

{!sinFaq && (
  <section data-theme="light" class="sec sec--light" id="preguntas">
    <div class="ebz-container split split--top" style="gap:56px">
      <div class="stack" style="flex:4 1 320px">
        <span class="ebz-overline" style="color:var(--text-accent)">Preguntas frecuentes</span>
        <h2 class="ebz-h2">Lo que preguntan los dueños.</h2>
      </div>
      <div style="flex:7 1 520px"><FaqVendedor /></div>
    </div>
  </section>
)}

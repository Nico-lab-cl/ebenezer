---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { migas } from '@/lib/schema';

/* Plantilla de las páginas legales (privacidad, cookies, términos):
   texto largo en una columna legible, índice y fecha de actualización. */
interface Props {
  titulo: string;
  metaTitulo: string;
  descripcion: string;
  ruta: string;
  actualizada: string;
  indice: { id: string; texto: string }[];
}
const { titulo, metaTitulo, descripcion, ruta, actualizada, indice } = Astro.props;
const site = Astro.site!;
const crumbs = [{ nombre: 'Inicio', url: '/' }, { nombre: titulo, url: ruta }];
---
<Base title={metaTitulo} description={descripcion} schema={[migas(site, crumbs)]}>
  <div data-theme="light" class="sec--light">
    <div class="ebz-container legal">
      <Breadcrumbs items={crumbs} />
      <header class="legal__head">
        <h1 class="ebz-h1">{titulo}</h1>
        <p class="ebz-caption">Última actualización {actualizada}</p>
      </header>
      <div class="legal__grid">
        <nav class="legal__indice" aria-label="Índice">
          <p class="ebz-overline">Contenido</p>
          <ol>{indice.map((i) => <li><a href={`#${i.id}`}>{i.texto}</a></li>)}</ol>
        </nav>
        <article class="legal__texto"><slot /></article>
      </div>
    </div>
  </div>
</Base>

<style>
  .legal{padding-top:28px;padding-bottom:80px}
  .legal__head{display:flex;flex-direction:column;gap:10px;margin:20px 0 36px;max-width:760px}
  .legal__grid{display:grid;grid-template-columns:240px minmax(0,1fr);gap:56px;align-items:start}
  .legal__indice{position:sticky;top:96px;display:flex;flex-direction:column;gap:10px;font-size:14px}
  .legal__indice ol{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:8px}
  .legal__indice a{color:var(--text-secondary);text-decoration:none}
  .legal__indice a:hover{color:var(--text-accent)}
  .legal__texto{max-width:760px;display:flex;flex-direction:column;gap:14px;font-size:16px;line-height:1.7;color:var(--text-primary)}
  .legal__texto :global(h2){font-family:var(--font-display);font-weight:800;font-style:italic;font-size:26px;line-height:1.2;margin:28px 0 4px;scroll-margin-top:96px}
  .legal__texto :global(h3){font-family:var(--font-display);font-weight:700;font-size:19px;margin:12px 0 0}
  .legal__texto :global(p),.legal__texto :global(li){color:var(--text-secondary)}
  .legal__texto :global(b){color:var(--text-primary)}
  .legal__texto :global(ul){margin:0;padding-left:22px;display:flex;flex-direction:column;gap:6px}
  .legal__texto :global(a){color:var(--text-accent);text-decoration:underline;text-underline-offset:3px}
  .legal__texto :global(.tabla){overflow-x:auto;border:1px solid var(--border-default)}
  .legal__texto :global(table){border-collapse:collapse;width:100%;min-width:560px;font-size:14px}
  .legal__texto :global(th),.legal__texto :global(td){padding:10px 12px;text-align:left;vertical-align:top;border-bottom:1px solid var(--border-subtle)}
  .legal__texto :global(th){background:var(--bg-sunken);color:var(--text-primary);font-weight:700}
  .legal__texto :global(.btn-texto){align-self:flex-start;padding:10px 18px;border:0;cursor:pointer;background:var(--grafito-900);color:#fff;font-family:var(--font-display);font-weight:800;font-style:italic;text-transform:uppercase}
  @media (max-width:1023px){.legal__grid{grid-template-columns:1fr;gap:28px}.legal__indice{position:static}}
</style>

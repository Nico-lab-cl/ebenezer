---
/* Medición y consentimiento (Ley 21.719).

   Google Tag Manager, Microsoft Clarity, Google Analytics 4 y Meta Pixel NO se
   cargan hasta que la persona los acepta en el aviso de cookies
   (CookieAviso.astro). Sin consentimiento no se pide nada a Google, Microsoft
   ni Meta.
   - GTM: se carga si acepta medición o publicidad, con Consent Mode v2
     (analytics_storage / ad_storage / ad_user_data / ad_personalization según
     lo que aceptó). Las etiquetas dentro de GTM deben respetar ese
     consentimiento (configurarlas con "Consent Mode" en GTM).
   - Clarity: sólo con medición. Graba sesiones y mapas de calor.
   - Meta Pixel más Conversions API: ver meta() abajo y src/pages/api/meta.ts.
   - GA4 y Pixel directos: sólo si sus IDs están en ajustes. Si GA4 o el Pixel
     se configuran dentro de GTM, dejar esos IDs vacíos para no duplicar.
   El <noscript> de GTM no se usa: cargaría Google sin consentimiento.

   La decisión se guarda en localStorage ("ebz-consentimiento") con su versión
   y fecha; se vuelve a preguntar si cambia la versión o pasan 12 meses.

   Siempre se ejecuta (local, sin cookies ni terceros):
   - guarda el origen de la visita (utm_*, fbclid, gclid) en sessionStorage,
     sólo para adjuntarlo a la solicitud que la persona envíe (se borra al
     cerrar la pestaña);
   - window.ebzTrack(), que usan los formularios: no hace nada si la persona
     no aceptó la medición o la publicidad. */
import ajustes from '@/content/ajustes.json';

const pixel = String(ajustes.metaPixelId || '').replace(/\D/g, '');
const ga = String(ajustes.ga4Id || '').trim();
const gtm = String(ajustes.gtmId || '').trim();
const clarity = String(ajustes.clarityId || '').trim();
---
<script is:inline define:vars={{ pixel, ga, gtm, clarity }}>
  (function () {
    var CLAVE = 'ebz-consentimiento';
    var VERSION = 1;
    var DOCE_MESES = 365 * 24 * 60 * 60 * 1000;

    try {
      var q = new URLSearchParams(location.search), o = {};
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid'].forEach(function (k) { if (q.get(k)) o[k] = q.get(k); });
      if (Object.keys(o).length) sessionStorage.setItem('ebz-origen', JSON.stringify(o));
      else if (!sessionStorage.getItem('ebz-origen') && document.referrer && new URL(document.referrer).host !== location.host)
        sessionStorage.setItem('ebz-origen', JSON.stringify({ utm_source: new URL(document.referrer).host, utm_medium: 'referral' }));
    } catch (e) {}

    function leer() {
      try {
        var c = JSON.parse(localStorage.getItem(CLAVE) || 'null');
        if (!c || c.v !== VERSION || Date.now() - c.fecha > DOCE_MESES) return null;
        return c;
      } catch (e) { return null; }
    }

    var cargadoGA = false, cargadoPixel = false, cargadoGTM = false, cargadoClarity = false;
    window.dataLayer = window.dataLayer || [];
    if (!window.gtag) window.gtag = function () { window.dataLayer.push(arguments); };
    // Consent Mode v2: todo denegado hasta que la persona decida.
    window.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500 });

    function aplicar(c) {
      if (!c) return;
      var si = function (v) { return v ? 'granted' : 'denied'; };
      window.gtag('consent', 'update', { analytics_storage: si(c.analitica), ad_storage: si(c.publicidad), ad_user_data: si(c.publicidad), ad_personalization: si(c.publicidad) });
      window.dataLayer.push({ event: 'ebz_consentimiento', analitica: c.analitica, publicidad: c.publicidad });
      if ((c.analitica || c.publicidad) && gtm && !cargadoGTM) {
        cargadoGTM = true;
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtm);
      }
      if (c.analitica && clarity && !cargadoClarity) {
        cargadoClarity = true;
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", clarity);
        window.clarity('consent');
      }
      if (c.analitica && ga && !cargadoGA) {
        cargadoGA = true;
        window.gtag('js', new Date());
        window.gtag('config', ga, { anonymize_ip: true });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga;
        document.head.appendChild(s);
      }
      if (c.publicidad && pixel && !cargadoPixel) {
        cargadoPixel = true;
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', pixel);
        meta('PageView');
        if (/^\/autos\/[^/]+\/?$/.test(location.pathname)) meta('ViewContent', { content_type: 'vehicle' });
      }
    }

    /* Meta: cada evento va al Pixel y, con el mismo event_id, a la Conversions
       API (/api/meta en el Worker) para que Meta lo deduplique. Sólo corre si
       la persona aceptó publicidad (si no, el Pixel no está cargado). Los
       eventos propios (trackCustom) van sólo al Pixel. */
    function meta(evento, datos, usuario, propio) {
      if (!cargadoPixel) return;
      var id = window.crypto && crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2);
      window.fbq(propio ? 'trackCustom' : 'track', evento, datos || {}, { eventID: id });
      if (propio) return;
      var o = {};
      try { o = JSON.parse(sessionStorage.getItem('ebz-origen') || '{}'); } catch (e) {}
      var cuerpo = JSON.stringify({ evento: evento, id: id, url: location.href, datos: datos, usuario: usuario, fbclid: o.fbclid });
      try {
        if (!navigator.sendBeacon || !navigator.sendBeacon('/api/meta', new Blob([cuerpo], { type: 'text/plain' })))
          fetch('/api/meta', { method: 'POST', body: cuerpo, keepalive: true });
      } catch (e) {}
    }

    /* API para el aviso de cookies. Retirar el consentimiento recarga la página
       para que los scripts ya cargados dejen de ejecutarse. */
    window.ebzConsentimiento = {
      actual: leer,
      guardar: function (analitica, publicidad) {
        var antes = leer();
        var c = { v: VERSION, fecha: Date.now(), analitica: !!analitica, publicidad: !!publicidad };
        try { localStorage.setItem(CLAVE, JSON.stringify(c)); } catch (e) {}
        var retira = antes && ((antes.analitica && !c.analitica) || (antes.publicidad && !c.publicidad));
        if (retira) location.reload();
        else aplicar(c);
        return c;
      },
      hayHerramientas: Boolean(ga || pixel || gtm || clarity),
    };
    aplicar(leer());

    window.ebzTrack = function (evento, datos, usuario) {
      datos = datos || {};
      var estandar = evento === 'Lead' || evento === 'Contact';
      meta(evento, estandar ? { content_category: datos.tipo || 'whatsapp' } : datos, estandar ? usuario : undefined, !estandar);
      if (cargadoGA) window.gtag('event', evento === 'Lead' ? 'generate_lead' : evento === 'Contact' ? 'contact' : 'form_step', datos);
      // Para GTM: eventos en el dataLayer (crear activadores con estos nombres).
      window.dataLayer.push(Object.assign({ event: evento === 'Lead' ? 'ebz_lead' : evento === 'Contact' ? 'ebz_contacto' : 'ebz_paso_formulario' }, datos));
    };

    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href*="wa.me"]');
      if (a) window.ebzTrack('Contact', { tipo: 'whatsapp', pagina: location.pathname });
    });
  })();
</script>

---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { clp, cuota, miles, redondear } from '@/lib/formato';
import { mensaje, numeroWhatsapp, type AutoWa } from '@/lib/whatsapp';
import ajustes from '@/content/ajustes.json';

/* Simulador de crédito + solicitud de evaluación. El financiamiento es directo
   con la automotora. El HTML trae el resultado inicial ya calculado (funciona
   sin JS); el script recalcula y copia los valores a la solicitud, que se guarda
   en la planilla (pestaña "Crédito").

   Dos modos, tomados de lo mejor de la competencia:
   - en la ficha de un auto (`auto`): el valor es el precio del auto, fijo;
   - en /financiamiento (`editable`): se escribe el valor de cualquier auto
     (input + slider), como en Auto360.
   En ambos: pie en % (desde el mínimo), plazo, cuota, monto a financiar, total
   en cuotas y tasa anual referencial. La CAE no se calcula aquí porque depende
   de gastos y seguros que sólo se conocen en la cotización formal. */
interface Props {
  precio: number;
  auto?: AutoWa;
  editable?: boolean;
}
const { precio, auto, editable = false } = Astro.props;
const tasa = ajustes.tasaMensual;
const plazos = [12, 24, 36, 48, 60];
const pieMinPct = Math.round(ajustes.pieMinimo * 100);
const piePct = Math.max(pieMinPct, 30);
const pie = redondear((precio * piePct) / 100);
const n = 36;
const c = cuota(precio - pie, tasa, n);
const base = mensaje('financiamiento', auto);
const pct = (x: number) => (x * 100).toFixed(1).replace('.', ',') + '%';
const tasaTxt = (tasa * 100).toFixed(2).replace('.', ',') + '%';
const tasaAnual = pct(Math.pow(1 + tasa, 12) - 1);
const nombreAuto = auto ? [auto.marca, auto.modelo, auto.anio].filter(Boolean).join(' ') : '';
const VALOR_MIN = 2000000;
const VALOR_MAX = 60000000;
const SITUACIONES = ['Dependiente', 'Independiente', 'Pensionado', 'Otra'];
const RENTAS = ['Menos de $500.000', '$500.000 a $1.000.000', '$1.000.000 a $1.500.000', '$1.500.000 a $2.500.000', 'Más de $2.500.000'];
const f = (k: string) => `sim-${editable ? 'libre' : precio}-${k}`;
---
<section class="ebz-sim" data-theme="dark" aria-label="Simulador de crédito" id={editable ? 'simulador' : undefined} data-sim data-precio={precio} data-tasa={tasa} data-wa={numeroWhatsapp()} data-msg={base}>
  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px">
    <h3 class="ebz-h5" style="font-style:italic;font-weight:800">Simula tu crédito</h3>
    {!editable && <span class="ebz-caption">Valor <b class="ebz-num" style="color:#fff">{clp(precio)}</b></span>}
  </div>

  {editable && (
    <>
      <div class="ebz-field">
        <label class="ebz-label" for={f('valor')}>Valor del auto</label>
        <div class="ebz-control"><span class="lead__prefijo">$</span><input id={f('valor')} class="ebz-input lead__con-prefijo ebz-num" inputmode="numeric" value={miles(precio)} data-sim-valor aria-describedby={f('valor-ayuda')} /></div>
        <input type="range" min={VALOR_MIN} max={VALOR_MAX} step="100000" value={Math.min(Math.max(precio, VALOR_MIN), VALOR_MAX)} aria-label="Valor del auto" data-sim-valor-rango />
        <span class="sim__ayuda" id={f('valor-ayuda')}>Escribe el valor del auto que te interesa o mueve la barra.</span>
      </div>
    </>
  )}

  <div class="ebz-field">
    <label class="ebz-label" style="display:flex;justify-content:space-between" for={f('pie')}>Pie <span class="ebz-num" style="color:#fff;letter-spacing:0;font-size:14px" data-pie-txt>{clp(pie)} · {piePct}%</span></label>
    <input id={f('pie')} type="range" min={pieMinPct} max="80" step="1" value={piePct} data-pie />
    <span class="sim__ayuda">Pie mínimo {pieMinPct}%.</span>
  </div>
  <div class="ebz-field">
    <span class="ebz-label">Plazo (meses)</span>
    <div class="ebz-seg" role="group" aria-label="Plazo en meses">
      {plazos.map((p) => <button type="button" aria-pressed={p === n ? 'true' : 'false'} data-plazo={p}>{p}</button>)}
    </div>
  </div>
  <div class="ebz-sim__result" aria-live="polite">
    <div class="ebz-label">Cuota referencial</div>
    <div class="ebz-price ebz-price-lg" style="color:var(--naranja-500);margin-top:6px"><span data-cuota>{clp(c)}</span><span style="font-size:16px;color:var(--grafito-300);font-style:normal;font-weight:600"> /mes</span></div>
    <dl class="sim__detalle">
      <div><dt>Monto a financiar</dt><dd class="ebz-num" data-monto>{clp(precio - pie)}</dd></div>
      <div><dt>Cuotas</dt><dd class="ebz-num" data-n>{n}</dd></div>
      <div><dt>Total en cuotas</dt><dd class="ebz-num" data-total>{clp(c * n)}</dd></div>
      <div><dt>Tasa anual ref.</dt><dd class="ebz-num">{tasaAnual}</dd></div>
    </dl>
  </div>

  <Button type="button" block iconRight="arrow-right" data-sim-abrir hidden>Solicitar evaluación</Button>

  <form class="sim__solicitud" data-lead="credito" data-wa={numeroWhatsapp()} data-sheets={ajustes.sheetsUrl} data-sim-form>
    <div class="sim__campos" data-campos>
      <p class="ebz-label sim__titulo">Solicitud de evaluación</p>
      <input type="hidden" name="auto_interes" value={nombreAuto} />
      <input type="hidden" name="precio_auto" value={clp(precio)} data-h-precio />
      <input type="hidden" name="pie" value={clp(pie)} data-h-pie />
      <input type="hidden" name="plazo" value={n} data-h-plazo />
      <input type="hidden" name="cuota_simulada" value={clp(c)} data-h-cuota />
      <div class="ebz-field lead__ancho">
        <label class="ebz-label" for={f('nombre')}>Nombre</label>
        <div class="ebz-control"><input id={f('nombre')} name="nombre" class="ebz-input" placeholder="Nombre y apellido" autocomplete="name" required /></div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('tel')}>WhatsApp</label>
        <div class="ebz-control"><input id={f('tel')} name="telefono" type="tel" class="ebz-input" placeholder="+56 9 1234 5678" autocomplete="tel" required pattern="[0-9+ ]{8,16}" /></div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('email')}>Email <span class="lead__opc">opcional</span></label>
        <div class="ebz-control"><input id={f('email')} name="email" type="email" class="ebz-input" placeholder="tu@email.cl" autocomplete="email" /></div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('situacion')}>Situación laboral</label>
        <div class="ebz-control">
          <select id={f('situacion')} name="situacion_laboral" class="ebz-select" required><option value="">Selecciona</option>{SITUACIONES.map((s) => <option>{s}</option>)}</select>
          <Icon name="chevron-down" size={18} class="ebz-select__chev" />
        </div>
      </div>
      <div class="ebz-field">
        <label class="ebz-label" for={f('renta')}>Renta líquida mensual</label>
        <div class="ebz-control">
          <select id={f('renta')} name="renta" class="ebz-select" required><option value="">Selecciona</option>{RENTAS.map((r) => <option>{r}</option>)}</select>
          <Icon name="chevron-down" size={18} class="ebz-select__chev" />
        </div>
      </div>
      <div class="ebz-field lead__ancho">
        <label class="ebz-label" for={f('pdp')}>¿Tienes un auto para dejar en parte de pago?</label>
        <div class="ebz-control">
          <select id={f('pdp')} name="parte_de_pago" class="ebz-select" required><option value="">Selecciona</option><option>No</option><option>Sí</option></select>
          <Icon name="chevron-down" size={18} class="ebz-select__chev" />
        </div>
      </div>
      <label class="lead__check"><input type="checkbox" name="acepta_contacto" value="sí" required /> <span>Acepto que me contacten por WhatsApp sobre esta solicitud.</span></label>
      <div class="lead__oculto" aria-hidden="true"><label>No llenar<input name="sitio_web" tabindex="-1" autocomplete="off" /></label></div>
      <div class="lead__ancho"><Button type="submit" block iconRight="arrow-right">Enviar solicitud con esta simulación</Button></div>
    </div>
    <div class="lead__gracias" data-gracias hidden>
      <span class="lead__ok"><Icon name="check" size={28} /></span>
      <h3 class="ebz-h4" tabindex="-1">Recibimos tu solicitud.</h3>
      <p class="ebz-body-sm muted">Te escribimos por WhatsApp para pedirte los antecedentes y evaluar tu crédito.</p>
      <Button href="#" target="_blank" icon="whatsapp" variant="secondary" data-gracias-wa>Seguir por WhatsApp</Button>
    </div>
  </form>

  <a class="sim__wa" href={`https://wa.me/${numeroWhatsapp()}?text=${encodeURIComponent(base)}`} target="_blank" rel="noopener" data-sim-wa>¿Prefieres conversarlo? Escríbenos por WhatsApp</a>
  <p class="ebz-sim__fine">Financiamiento directo con {ajustes.nombre}. Valores referenciales, sujetos a evaluación crediticia. Tasa mensual referencial {tasaTxt} (anual {tasaAnual}). No incluye gastos operacionales, impuestos ni seguros. La CAE se informa en la cotización formal.</p>
</section>

<script>
  import '@/scripts/leads';

  const miles = (n: number) => Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  const clp = (n: number) => '$' + miles(n);
  const redondear = (n: number) => Math.round(n / 100000) * 100000;
  const cuota = (k: number, r: number, n: number) => (r === 0 ? k / n : (k * r) / (1 - Math.pow(1 + r, -n)));

  for (const el of document.querySelectorAll<HTMLElement>('[data-sim]')) {
    const tasa = Number(el.dataset.tasa);
    let precio = Number(el.dataset.precio);
    const q = <T extends Element>(s: string) => el.querySelector<T>(s);
    const rangoPie = q<HTMLInputElement>('[data-pie]')!;
    const botones = [...el.querySelectorAll<HTMLButtonElement>('[data-plazo]')];
    const wa = q<HTMLAnchorElement>('[data-sim-wa]')!;
    const form = q<HTMLFormElement>('[data-sim-form]')!;
    const abrir = q<HTMLButtonElement>('[data-sim-abrir]')!;
    const valor = q<HTMLInputElement>('[data-sim-valor]');
    const rangoValor = q<HTMLInputElement>('[data-sim-valor-rango]');
    const h = (k: string) => form.querySelector<HTMLInputElement>(`[data-h-${k}]`)!;
    let n = Number(botones.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.plazo ?? 36);

    // Con JS la solicitud se abre al pedirla; sin JS queda siempre visible.
    form.hidden = true;
    abrir.hidden = false;
    abrir.addEventListener('click', () => {
      abrir.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLElement>('input:not([type=hidden]),select')?.focus();
    });

    const pintar = () => {
      const pie = redondear((precio * Number(rangoPie.value)) / 100);
      const monto = Math.max(precio - pie, 0);
      const c = monto > 0 ? cuota(monto, tasa, n) : 0;
      q('[data-pie-txt]')!.textContent = `${clp(pie)} · ${rangoPie.value}%`;
      q('[data-cuota]')!.textContent = clp(c);
      q('[data-monto]')!.textContent = clp(monto);
      q('[data-n]')!.textContent = String(n);
      q('[data-total]')!.textContent = clp(c * n);
      h('precio').value = clp(precio);
      h('pie').value = clp(pie);
      h('plazo').value = String(n);
      h('cuota').value = clp(c);
      const texto = `${el.dataset.msg}. Simulé un auto de ${clp(precio)} con ${clp(pie)} de pie a ${n} meses (cuota ref. ${clp(c)}).`;
      wa.href = `https://wa.me/${el.dataset.wa}?text=${encodeURIComponent(texto)}`;
    };

    // Modo libre (/financiamiento): valor escrito o slider, sincronizados.
    const fijarValor = (v: number, desde: 'input' | 'rango') => {
      precio = v;
      if (valor && desde !== 'input') valor.value = miles(v);
      if (rangoValor && desde !== 'rango') rangoValor.value = String(v);
      pintar();
    };
    valor?.addEventListener('input', () => {
      const digitos = valor.value.replace(/\D/g, '').slice(0, 10);
      valor.value = digitos ? miles(Number(digitos)) : '';
      const v = Number(digitos);
      valor.setCustomValidity(v && v < 1000000 ? 'Ingresa un valor desde $1.000.000.' : '');
      if (v >= 1000000) fijarValor(v, 'input');
    });
    rangoValor?.addEventListener('input', () => fijarValor(Number(rangoValor.value), 'rango'));

    rangoPie.addEventListener('input', pintar);
    for (const b of botones)
      b.addEventListener('click', () => {
        n = Number(b.dataset.plazo);
        for (const o of botones) o.setAttribute('aria-pressed', String(o === b));
        pintar();
      });
    pintar();
  }
</script>

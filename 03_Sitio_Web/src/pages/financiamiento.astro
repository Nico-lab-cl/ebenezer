---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import CreditSimulator from '@/components/CreditSimulator.astro';
import { vehiculos } from '@/lib/vehiculos';
import ajustes from '@/content/ajustes.json';
import { real } from '@/lib/datos';

const [primero] = (await vehiculos()).filter((v) => v.data.etiqueta !== 'vendido');
const pie = Math.round(ajustes.pieMinimo * 100);
const PASOS = [
  ['Simula', 'Elige el pie y el plazo. La cuota es referencial.'],
  ['Evaluación', 'Envías la solicitud y evaluamos tus antecedentes nosotros mismos, porque el financiamiento es directo con la automotora.'],
  ['Firma y retira', 'Con el crédito aprobado firmas y te llevas el auto, con la transferencia hecha.'],
];
const REQUISITOS = [
  'Cédula de identidad vigente',
  'Últimas liquidaciones de sueldo o boletas de honorarios',
  'Certificado de cotizaciones AFP',
  `Pie disponible (desde ${pie}% del valor del auto)`,
];
const FAQ = [
  ['¿La cuota que veo en la web es final?', 'No. Es referencial y depende de la evaluación crediticia. La cuota final, la tasa y la CAE se informan en la cotización formal.'],
  ['¿Puedo dejar mi auto en parte de pago?', 'Sí. Lo tasamos y el valor se descuenta del precio del auto que compras.'],
  ['¿Cuánto demora la evaluación?', '[Plazo habitual de la evaluación]'],
  ['¿Qué pasa si no me aprueban?', 'Te avisamos y vemos alternativas, como más pie, otro plazo u otro auto.'],
].filter(([, a]) => real(a));
---
<Base
  title="Automotora con crédito directo · Financia tu auto usado"
  description={`Financia tu auto usado o seminuevo con pie desde ${pie}%. Financiamiento directo con la automotora: simula la cuota, envía tu solicitud y conoce la CAE antes de firmar. Toda la Región de Valparaíso.`}
  fab={{ context: 'financiamiento' }}
>
  <section class="ebz-container sec--lg">
    <div class="split" style="gap:56px">
      <div class="stack" style="gap:22px;flex:6 1 440px">
        <span class="ebz-overline ebz-overline-rule" style="color:var(--grafito-300)">Financiamiento automotriz</span>
        <h1 class="ebz-h1">Automotora con crédito directo y pie desde {pie}%</h1>
        <p class="ebz-body-lg muted" style="max-width:560px">Financiamiento directo con {ajustes.nombre}, sin intermediarios. Simula la cuota, envía tu solicitud y te mostramos la CAE antes de firmar.</p>
        <div class="row">
          <Button size="lg" href="#simulador" iconRight="arrow-right">Simular mi crédito</Button>
          <Button variant="secondary" size="lg" href="/autos-usados/">Ver autos</Button>
        </div>
      </div>
      <div style="flex:5 1 380px">
        <CreditSimulator precio={primero?.data.precio ?? 12990000} editable />
      </div>
    </div>
  </section>

  <section class="sec sec--alt">
    <div class="ebz-container">
      <h2 class="ebz-h2" style="margin-bottom:36px">Cómo funciona el crédito directo</h2>
      <ol class="grid-3" style="list-style:none;margin:0;padding:0">
        {PASOS.map(([t, d], i) => (
          <li class="card card--sunken"><span class="num-step">0{i + 1}</span><b class="ebz-h5">{t}</b><p class="ebz-body-sm muted">{d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section data-theme="light" class="sec sec--light" id="preguntas">
    <div class="ebz-container split split--top" style="gap:56px">
      <div class="stack" style="flex:5 1 360px">
        <span class="ebz-overline" style="color:var(--text-accent)">Requisitos</span>
        <h2 class="ebz-h3">Requisitos para el crédito directo</h2>
        <ul class="lista-check">
          {REQUISITOS.map((r) => <li><Icon name="check" size={18} /><span class="ebz-body">{r}</span></li>)}
        </ul>
        <p class="ebz-caption">Según el caso, podemos pedirte antecedentes adicionales.</p>
      </div>
      <div class="stack" style="gap:12px;flex:6 1 420px">
        <h2 class="ebz-overline" style="color:var(--text-accent);margin:0">Preguntas frecuentes</h2>
        {FAQ.map(([q, a]) => (
          <details class="faq"><summary>{q}</summary><p>{a}</p></details>
        ))}
      </div>
    </div>
  </section>
</Base>

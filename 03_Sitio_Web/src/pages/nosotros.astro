---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import { migas, preguntas } from '@/lib/schema';
import { PREGUNTAS_NOSOTROS } from '@/lib/faq';
import Faq from '@/components/Faq.astro';
import patricio from '@/assets/marca/patricio-escobar.jpg';

const VALORES = [
  ['clipboard-check', 'Revisamos antes de publicar', 'Cada auto pasa por una revisión visual y mecánica antes de salir a la venta.'],
  ['receipt', 'Precio final a la vista', 'El precio publicado incluye IVA y se informa qué no está incluido. Sin cargos sorpresa al firmar.'],
  ['message-circle', 'Te respondemos por WhatsApp', 'Fotos extra, videos o una llamada, lo que necesites para decidir sin moverte.'],
];
/* Texto de presentación: borrador con datos confirmados (fundador, base en El
   Tabo, más de 5 años de Patricio en el rubro inmobiliario, servicios, forma
   de trabajo). El nombre no lleva explicación, por decisión de la automotora. */
const site = Astro.site!;
---
<Base
  title="Automotora del litoral central en El Tabo | EBENEZER"
  description="EBENEZER es una automotora con base en El Tabo que compra, vende y consigna autos usados en toda la Región de Valparaíso. Autos revisados y cuentas claras."
  schema={[preguntas(PREGUNTAS_NOSOTROS), migas(site, [{ nombre: 'Inicio', url: '/' }, { nombre: 'Nosotros', url: '/nosotros/' }])]}
>
  <section style="position:relative;overflow:hidden" class="sec--lg">
    <div class="studio" style="position:absolute;top:0;bottom:0;right:0;width:44%;clip-path:polygon(22% 0,100% 0,100% 100%,0 100%)"></div>
    <div class="ebz-container split" style="position:relative">
      <div class="stack" style="gap:22px;flex:6 1 440px">
        <span class="ebz-overline ebz-overline-rule" style="color:var(--grafito-300)">Nosotros</span>
        <h1 class="ebz-h1">Una automotora de la región con las cuentas claras</h1>
        <p class="ebz-body-lg muted" style="max-width:560px">EBENEZER es una automotora que nace de la convicción de que comprar o vender un auto usado puede ser simple, seguro y transparente. Partimos en El Tabo, en el litoral central, y hoy atendemos a dueños y compradores de toda la Región de Valparaíso.</p>
      </div>
      <div style="flex:5 1 340px;display:flex;justify-content:center">
        <Image src={patricio} alt="Patricio Escobar, fundador de EBENEZER Automotora, junto a un Audi TT" widths={[360, 480, 720, 960]} sizes="(max-width: 1023px) 90vw, 480px" format="webp" loading="eager" fetchpriority="high" class="foto-patricio" />
      </div>
    </div>
  </section>

  <section class="ebz-container sec">
    <div class="split split--top" style="gap:56px">
      <div class="stack" style="flex:4 1 320px">
        <span class="ebz-overline" style="color:var(--naranja-500)">Fundador</span>
        <h2 class="ebz-h2">Quién está detrás de EBENEZER</h2>
      </div>
      <div class="stack" style="flex:7 1 520px;gap:16px">
        <p class="ebz-body-lg">EBENEZER es un proyecto de Patricio Escobar, que suma más de 5 años de experiencia en el rubro inmobiliario acompañando a sus clientes en compras importantes. Esa misma forma de trabajar, cercana y con las cuentas claras, es la que trae a la venta de autos.</p>
        <p class="ebz-body">Patricio atiende personalmente a cada cliente, desde la primera conversación por WhatsApp hasta la firma de la transferencia.</p>
        <p class="ebz-body muted">Vendemos tu auto en consignación o te lo compramos directo, publicamos autos usados revisados y ofrecemos crédito directo con la automotora. La idea es que sepas siempre en qué etapa va tu auto o tu compra, sin letra chica.</p>
      </div>
    </div>
  </section>

  <section class="sec sec--alt">
    <div class="ebz-container">
      <h2 class="ebz-h2" style="margin-bottom:36px">Cómo trabajamos</h2>
      <div class="grid-3">
        {VALORES.map(([ic, t, d]) => (
          <div class="card card--sunken" style="gap:14px"><Icon name={ic!} size={32} style="color:var(--naranja-500)" /><b class="ebz-h4" style="font-style:italic">{t}</b><p class="ebz-body-sm muted">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="ebz-container sec--lg">
    <div class="row" style="justify-content:space-between;gap:40px">
      <div class="stack" style="gap:14px;max-width:680px">
        <span class="ebz-overline" style="color:var(--naranja-500)">Dónde atendemos</span>
        <h2 class="ebz-h3">Base en El Tabo · atendemos toda la Región de Valparaíso</h2>
      </div>
      <Button size="lg" iconRight="arrow-right" href="/contacto/">Escríbenos</Button>
    </div>
  </section>

  <section data-theme="light" class="sec sec--light" id="preguntas">
    <div class="ebz-container split split--top" style="gap:56px">
      <div class="stack" style="flex:4 1 320px">
        <span class="ebz-overline" style="color:var(--text-accent)">Preguntas frecuentes</span>
        <h2 class="ebz-h2">Sobre EBENEZER Automotora</h2>
      </div>
      <div style="flex:7 1 520px"><Faq items={PREGUNTAS_NOSOTROS} /></div>
    </div>
  </section>
</Base>

<style>
  .foto-patricio{width:100%;max-width:480px;height:auto;aspect-ratio:4/5;object-fit:cover;box-shadow:0 30px 60px rgba(10,12,15,.45);border-bottom:4px solid var(--naranja-500)}
</style>
